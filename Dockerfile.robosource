# RoboSource build: reuses the upstream v1.8.4 image's production node_modules
# (which carry @wyre-ai/node-halopsa from GitHub Packages, a registry that
# needs a read:packages token) and recompiles only this fork's src on top.
ARG UPSTREAM=ghcr.io/wyre-ai/halopsa-mcp@sha256:3b90158dd63d751c252b3350d31f432652b855492b8cf8b481d404712ba397a9

FROM ${UPSTREAM} AS upstream

FROM node:26-alpine AS builder
WORKDIR /tools
RUN echo '{"name":"tools","private":true}' > package.json && \
    npm install --no-package-lock --ignore-scripts \
      typescript@^6.0.3 vitest@^5.0.3 @types/node@^26.6.4 @modelcontextprotocol/ext-apps@^2.0.3
WORKDIR /app
COPY --from=upstream /app/node_modules ./node_modules
RUN cp -Rn /tools/node_modules/. ./node_modules/ || true
COPY package.json tsconfig.json ./
COPY src ./src
RUN ./node_modules/.bin/tsc

FROM ${UPSTREAM}
COPY --from=builder /app/dist /app/dist
